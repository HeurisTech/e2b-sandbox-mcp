{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": false,
    "outDir": "./dist",
    "rootDir": "./src",
    "resolveJsonModule": true,
    "noEmitOnError": false
  },
  "include": ["src/app.ts", "src/server.ts", "src/sandbox-manager.ts", "src/computer-use-tools.ts"],
  "exclude": ["node_modules", "dist", "src/index.ts", "src/natural-language-tools.ts", "src/streaming", "src/types", "examples"]
}
